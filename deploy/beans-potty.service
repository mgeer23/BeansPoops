[Unit]
Description=Bean's Potty Log
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=exec
User=beans
Group=beans
WorkingDirectory=/opt/beans-potty
EnvironmentFile=/opt/beans-potty/.env
ExecStart=/opt/beans-potty/venv/bin/gunicorn --bind 127.0.0.1:5000 --workers 2 --timeout 30 app:app
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=beans-potty

[Install]
WantedBy=multi-user.target
